@startuml

title Components Diagram - CryptoService

package "CryptoService" {
    [Application Entry] as Entry
    package boundary {
        [Security Layer] as Security
        [API Layer] as API
        [Controller] as Controller
        [Validation Layer] as Validation
        [Authorization Layer] as Authorization
    }
    package businessfacade {
        [Business Facade] as BusinessFacade
    }
    package businesslogic {
        [Key Management] as KeyMgmt
        [JWT Management] as JwtMgmt
        [Crypto Logic] as Crypto
    }
    package errorhandling {
        [Error Handling] as Error
    }
    Entry --> Security
    Security --> API
    API --> Controller
    Controller -left-> Validation : 1
    Validation --> Error
    Controller -left-> Authorization : 2
    Authorization --> Error
    Controller -down-> BusinessFacade : 3
    BusinessFacade --> KeyMgmt
    BusinessFacade --> JwtMgmt
    BusinessFacade --> Crypto
    KeyMgmt --> Error
    JwtMgmt --> Error
    Crypto --> Error
}
@enduml
